# Credenciales reales — NUNCA commitear. Generado desde los exports de n8n.
APICON_BASE=
APICON_USERNAME=
APICON_PASSWORD=
APICON_CLIENT_ID=
APICON_CLIENT_SECRET=
APICON_EMPRESA_DEFECTO=
APICON_TOP=
# Modo solo-caché: 1 = nunca se llama al ERP (demos y previsualizaciones). Vacío = normal.
APICON_SOLO_CACHE=
# Cache
CACHE_TTL_APUNTES=
CACHE_DB=
# Base de datos. Vacío o ruta/SQLite → SQLite en local; postgresql://… → Postgres (Coolify).
# En producción se pone aquí la cadena del Postgres de Coolify.
DATABASE_URL=
# Seguridad del portal
# Obligatoria, mínimo 32 caracteres (firma las sesiones). Generar con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
TOKEN_TTL_MIN=
ADMIN_BOOTSTRAP_PASSWORD=
# CORS: vacío = cerrado (el panel se sirve del mismo origen que la API). Si el frontal vive en otro
# dominio, se pone aquí la lista separada por comas. `*` se ignora siempre.
CORS_ORIGENES=
