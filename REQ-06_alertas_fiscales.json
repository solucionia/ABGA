    {
      "id": "extraer-empresa",
      "name": "Extraer Datos Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 340],
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst empresa = $('Loop por Empresa').item.json;\nconst clientes = Array.isArray(data) ? data : (data.datos || data.value || [data]);\nconst primerCliente = clientes[0] || {};\n\nreturn [{\n  json: {\n    empresaId: empresa.id || empresa.codigo || empresa.Codigo,\n    empresaNombre: empresa.nombre || empresa.Nombre || primerCliente.NombreFiscal || 'Sin nombre',\n    email: primerCliente.Mail || primerCliente.mail || '',\n    cif: primerCliente.CIF || empresa.cif || ''\n  }\n}];"
      }
