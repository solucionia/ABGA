    {
      "id": "extraer-primer-cliente",
      "name": "Extraer Datos Empresa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 260],
      "parameters": {
        "jsCode": "// Extraer el primer cliente/empresa del array de resultados\nconst data = $input.item.json;\nconst empresa = $('Loop por Empresa').item.json;\n\n// El endpoint puede devolver array directo o { datos: [] }\nconst clientes = Array.isArray(data) ? data : (data.datos || data.value || [data]);\nconst primerCliente = clientes[0] || {};\n\nreturn [{\n  json: {\n    empresaId: empresa.id || empresa.codigo || empresa.Codigo,\n    empresaNombre: empresa.nombre || empresa.Nombre || empresa.razonSocial || primerCliente.NombreFiscal || primerCliente.NombreComercial || 'Sin nombre',\n    email: primerCliente.Mail || primerCliente.mail || primerCliente.email || '',\n    cif: primerCliente.CIF || empresa.cif || '',\n    raw: primerCliente\n  }\n}];"
      }
    },
